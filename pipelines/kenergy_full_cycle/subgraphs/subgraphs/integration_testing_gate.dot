// integration_testing_gate.dot
//
// Subgraph rendering of the "integration-testing-discipline" skill
// (skills/integration-testing-discipline/SKILL.md): OBSERVE FIRST, FIX IN
// BATCHES, NEVER FIX DURING ACTIVE E2E RUNS. Invoked from build_like_ken.dot
// when RouteVerificationLevel observes verification_level="dtu" (the
// heaviest VDD tier -- long-running container/DTU integration runs).
//
// This subgraph exists specifically to structurally prevent the failure mode
// the skill names: an LLM node seeing one failure mid-run and patching it
// immediately, which invalidates the run. The graph shape enforces the
// skill's four principles by construction -- observation and remediation are
// separate nodes with a hard boundary between them, not just a prompt asking
// nicely for discipline.
//
// Inputs:
//   $task_id  - task whose integration behavior is being verified
//
// Outputs:
//   integration.result       - "clean" | "failures_batched_and_fixed"
//   integration.report_path  - path to the full failure list + fix batch

digraph integration_testing_gate {
  graph [rankdir=LR, default_max_retry=1, default_fidelity="summary:high"];

  Start [shape=Mdiamond, label="Start"];
  Exit  [shape=Msquare,  label="Exit"];

  // Principle 2 (long-running is normal) and Principle 3 (check container
  // state directly) are enforced by giving this node NOTHING else to do --
  // it cannot "quick fix" because fixing isn't available to it; only
  // observation and recording are.
  ObserveRun [
    shape=box, goal_gate=true, fidelity="full",
    label="Observe Full Run (no fixes during this node)",
    prompt="Run the integration/E2E scenario for task ${task_id} to completion or real failure. OBSERVE FIRST. Do not make any code change during this run, no matter how small or obviously correct the fix seems -- one fix mid-run invalidates the whole run.\n\nDo not declare 'stuck' from wall-clock time alone. Check actual error signals: exit codes, error messages in logs, process death, hung processes. If progress seems inconsistent with what an API/monitor reports, check the container's internal state directly (docker exec: ls, cat trackers, ps aux) rather than trusting the monitor.\n\nCapture EVERY failure the run surfaces, in the order they occur, with exact error text and exact reproduction steps. Write .resolve/build/integration_observations_${task_id}.json with {\"clean\":true|false,\"failures\":[{\"error\":\"...\",\"where\":\"...\",\"repro\":\"...\"}]}. Print the single line: run_observed"
  ];

  ObservationGate [
    shape=parallelogram, label="Clean or Failures Found?",
    tool_command="#!/bin/sh\nset -e\npython3 -c \"import json;d=json.load(open('.resolve/build/integration_observations_${task_id}.json'));print('clean' if d['clean'] else 'has_failures')\""
  ];

  // Principle 1 (fix in batches, only after observation stops) and
  // Principle 4 (one run, all errors, fixed in dependency order).
  FixBatch [
    shape=box, goal_gate=true, fidelity="full",
    label="Fix All Observed Failures as One Coordinated Batch",
    prompt="Read every failure in .resolve/build/integration_observations_${task_id}.json. Address them together, in dependency order (fix the failure that unblocks others first). Do not fix one and start a new run to check it -- fix the whole batch, then hand off to a single fresh validation run.\n\nWrite .resolve/build/integration_fix_batch_${task_id}.json with {\"fixes_applied\":[{\"failure\":\"...\",\"fix\":\"...\",\"commit_sha\":\"...\"}]}. Print the single line: batch_fixed"
  ];

  // A second full observation run, never a partial re-check of just the
  // fixed failures -- matches Principle 4's "1 observation run + 1
  // validation run", not N interrupted runs.
  ValidationRun [
    shape=box, goal_gate=true, fidelity="full",
    label="Fresh Validation Run (full, not spot-check)",
    prompt="Run the same integration/E2E scenario for task ${task_id} again, fresh and complete, to confirm the fix batch actually converged. Write .resolve/build/integration_observations_${task_id}.json (overwrite) with the same shape as before. Print the single line: validation_run_done"
  ];

  Start            -> ObserveRun;
  ObserveRun       -> ObservationGate;
  ObservationGate  -> Exit     [condition="context.tool.last_line=clean", weight="2"];
  ObservationGate  -> FixBatch [condition="context.tool.last_line=has_failures"];
  FixBatch         -> ValidationRun;
  ValidationRun    -> ObservationGate [loop_restart="true", label="re-observe (bounded by graph's own default_max_retry=1 -- a second failure round escalates to /debug, it does not loop indefinitely here)"];
}
