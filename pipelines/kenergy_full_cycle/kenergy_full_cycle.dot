// kenergy_full_cycle.dot
//
// Top-level orchestrator composing all six kenergy mode-graphs into the full
// idea-to-finish arc: think_like_ken -> plan_like_ken -> build_like_ken ->
// (recommended) verify -> finish, with debug reachable as shared recovery
// from both build_like_ken (blocked) and verify (not_verified).
//
// This is the graph the six standalone mode-graphs were always meant to
// compose into -- mirrors kenergy-reference.md's own "Manual/standalone path"
// diagram exactly:
//   /think-like-ken -> /plan-like-ken -> /build-like-ken -> /verify (recommended) -> /finish
// with /debug reachable at any point a bug needs root-cause investigation.
//
// Naming note: this mirrors recipes/kenergy-full-development-cycle.yaml's
// name deliberately -- same lifecycle, DOT rendering instead of recipe YAML.
//
// Zero human checkpoints (2026-08-11 revision): this graph previously had
// two top-level human hexagons -- ResumeRoute (after Debug, "where do we
// resume") and RecommendVerify ("run /verify or skip to /finish"). Both are
// removed. ResumeRoute's judgment is now made by Debug itself: the root
// cause investigation already determines whether the fix is local
// (continue_build), the plan needs revision (replan), or the design itself
// was wrong (redesign) -- Debug's own report now states which, and a
// deterministic gate routes on that instead of asking. RecommendVerify's
// choice is no longer offered: /verify always runs (it was already the
// documented recommended default; removing the choice just makes the
// recommendation the only path, matching this session's stance that a
// pipeline should default to the more-thorough option rather than pause to
// ask which one to take).
//
// DESIGN ORDER (docs/primer.md §3):
//   1. THE SINK: `finish.dot`'s own sink (a confirmed, human-reviewable PR
//      opened) -- but only reachable after every upstream stage's own sink
//      was independently satisfied: think_like_ken's self-reviewed design,
//      plan_like_ken's contract-confirmed plan, build_like_ken's
//      all-tasks-accepted-or-explicitly-blocked verdict, and verify's
//      proven-not-asserted evidence (always run now, not optional).
//   2. THE GATE: per docs/RUBRIC.md §3.7, a `shape=folder` subgraph node
//      silently returns its LAST internal outcome to the parent graph even
//      when nothing meaningful happened inside it -- so this graph never
//      treats "the BuildLikeKen node finished" as success. CheckBuildVerdict
//      and CheckVerifyVerdict explicitly read the context fields each
//      subgraph is contracted to write (`context.build.verdict`,
//      `context.verify.verdict`) before routing anywhere.
//   3. THE LOOP: Debug is one shared recovery subgraph reachable from both
//      failure points (RUBRIC.md's differentiated-failure-edges doctrine --
//      a blocked build and unverified evidence are different failure
//      classes, but both genuinely need root-cause investigation, so both
//      route to the same investigation phase rather than each inventing a
//      bespoke patch path). Debug's own report now names the resume point
//      (continue_build/replan/redesign) as part of its terminal output --
//      CheckResumeRoute reads that deterministically rather than asking.
//   4. THE WORK NODES were written last: the six folder nodes plus the two
//      verdict gates and the (now deterministic) resume-routing gate.
//
// Subgraph placement: the six mode-graphs and their five skill-subgraphs are
// duplicated here under subgraphs/ and subgraphs/subgraphs/ respectively,
// preserving their exact original relative folder depth (e.g.
// build_like_ken.dot's own `dot_file="subgraphs/kenergy_reality_check.dot"`
// resolves the same way whether build_like_ken.dot lives at
// build_like_ken/build_like_ken.dot or here at
// kenergy_full_cycle/subgraphs/build_like_ken.dot, because both have a
// sibling subgraphs/ folder one level down). This keeps every standalone
// mode-graph runnable unmodified both on its own AND composed here -- one
// canonical copy of each mode's logic, reused two ways, per docs/RUBRIC.md
// §5's reuse discipline.
//
// Context inputs:
//   $topic           - the idea/feature being designed
//   $execution_root   - worktree/repo root every phase executes inside (all
//                        .resolve/ state and doc writes are anchored here)
//
// Context outputs:
//   cycle.finish_action - "pr" (always -- merge/keep/discard removed, see finish.dot's header)

digraph kenergy_full_cycle {
  graph [
    label="Kenergy Full Cycle -- idea to finish, six modes composed",
    goal="$topic",
    rankdir=LR,
    default_max_retry=2,
    default_fidelity="summary:high",
    model_stylesheet="* { llm_model: claude-sonnet-4-6; llm_provider: anthropic; }"
  ];

  Start [shape=Mdiamond, label="Start"];
  Exit  [shape=Msquare,  label="Exit"];

  // `inputs=` is not a real engine attribute anywhere in this file (see
  // build_like_ken.dot's DefineTaskCriteria note for the full explanation) --
  // it was silently a no-op everywhere it appeared. ThinkLikeKen needs no
  // replacement: $topic is this graph's own top-level param and already
  // flows into the child via the automatic context clone (same flat name on
  // both sides), so no injection was ever needed for it.
  ThinkLikeKen [
    shape=folder, label="/think-like-ken",
    dot_file="subgraphs/think_like_ken.dot",
    outputs="design.design_doc"
  ];

  // PlanLikeKen's child graph reads $design_doc (a flat key), but the only
  // value available in THIS parent's context is the dotted design.design_doc
  // ThinkLikeKen's own outputs= merge produced. A rename is genuinely needed
  // here (not just automatic clone-through, since the names differ) --
  // but `context.<key>` folder attrs are never substituted by the engine
  // (only tool_command/prompt/description/tool_env are), so a literal
  // context.design_doc="context.design.design_doc" would inject that literal
  // STRING, not the design doc path. A deterministic tool node bridges the
  // rename via parse_json="true" instead.
  RenameDesignDocForPlan [
    shape=parallelogram, label="Bridge design.design_doc -> design_doc", parse_json="true",
    tool_command="#!/bin/sh\nset -e\npython3 -c \"import json;print(json.dumps({'design_doc': '${design.design_doc}'}))\""
  ];

  PlanLikeKen [
    shape=folder, label="/plan-like-ken",
    dot_file="subgraphs/plan_like_ken.dot",
    outputs="plan.plan_doc"
  ];

  // Same rename need as RenameDesignDocForPlan above: BuildLikeKen's child
  // graph reads $plan_path, but this parent only has the dotted
  // plan.plan_doc PlanLikeKen's own outputs= merge produced.
  // $execution_root itself needs no bridge -- it is this graph's own
  // top-level param and already flows through via clone (same flat name).
  RenamePlanDocForBuild [
    shape=parallelogram, label="Bridge plan.plan_doc -> plan_path", parse_json="true",
    tool_command="#!/bin/sh\nset -e\npython3 -c \"import json;print(json.dumps({'plan_path': '${plan.plan_doc}'}))\""
  ];

  BuildLikeKen [
    shape=folder, label="/build-like-ken",
    dot_file="subgraphs/build_like_ken.dot",
    outputs="build.verdict,build.tasks_completed,build.blocked_task_id"
  ];

  // THE GATE for build_like_ken's return -- never assume "the folder node
  // finished" means all tasks landed.
  // ${context.build.verdict} was a broken substitution token: the ${...}
  // substitution engine does a literal snapshot lookup on whatever key is
  // inside the braces, and BuildLikeKen's outputs= merge (handlers/pipeline.py
  // step 11b2) copies the child's plain "build.verdict" key into this
  // parent's context AS "build.verdict" -- never as "context.build.verdict".
  // The old token therefore always resolved to the literal, unexpanded
  // string "${context.build.verdict}", so this gate's condition edges never
  // matched anything real (both would have silently no-matched and hit
  // the engine's fail-loud no_matching_edge error at the main-loop level).
  CheckBuildVerdict [
    shape=parallelogram, label="Check build.verdict",
    tool_command="#!/bin/sh\nset -e\nprintf '%s' \"${build.verdict}\""
  ];

  // Same rename need as the design_doc/plan_path bridges above -- debug.dot's
  // child graph reads $bug_description, but this parent only has the dotted
  // build.blocked_task_id (set by ComputeBuildVerdictBlocked). Split into two
  // unconditional bridge nodes, one per upstream edge -- the two cases are
  // already distinguished by which upstream edge delivered control
  // (CheckBuildVerdict.blocked vs CheckVerifyVerdict.not_verified), so no
  // conditional logic is needed inside either tool_command.
  RenameBugDescriptionForBuildBlocked [
    shape=parallelogram, label="Bridge -> bug_description (build blocked)", parse_json="true",
    tool_command="#!/bin/sh\nset -e\npython3 -c \"import json;print(json.dumps({'bug_description': 'Task ${build.blocked_task_id} blocked after bounded remediation -- see build ledger for the exact blocker.'}))\""
  ];

  RenameBugDescriptionForVerifyGap [
    shape=parallelogram, label="Bridge -> bug_description (verify gap)", parse_json="true",
    tool_command="#!/bin/sh\nset -e\npython3 -c \"import json;print(json.dumps({'bug_description': 'Verify reported NOT VERIFIED -- gap: ${verdict.gap}'}))\""
  ];

  Debug [
    shape=folder, label="/debug (shared recovery)",
    dot_file="subgraphs/debug.dot",
    outputs="debug.root_cause,debug.fix_commit_sha,debug.resume_route"
  ];

  // Zero human checkpoints (2026-08-11 revision): debug.dot's own final
  // Report node now names the resume point as part of its terminal output
  // (continue_build/replan/redesign), reasoned from the root cause and fix
  // it already investigated -- it is in the best position to know whether
  // the fix was local, the plan needs revision, or the design was wrong.
  // This deterministic gate just reads that call instead of asking a human.
  // Defaults to continue_build (the least disruptive option) if debug's
  // report is ambiguous or the field is missing, rather than failing loud --
  // an ambiguous resume signal should not block a run that otherwise has a
  // confirmed fix commit.
  CheckResumeRoute [
    shape=parallelogram, label="Resume Where? (after debug, deterministic)",
    tool_command="#!/bin/sh\nset -e\nroute=\"${debug.resume_route}\"\ncase \"$route\" in\n  continue_build|replan|redesign) printf '%s' \"$route\" ;;\n  *) printf 'continue_build' ;;\nesac"
  ];

  // /verify always runs now -- it was already documented as the
  // recommended default (kenergy-reference.md: "/verify remains the
  // recommended separate evidence-gathering step"); removing the
  // skip-to-finish choice just makes the recommendation the only path
  // rather than pausing to ask which one to take.
  Verify [
    shape=folder, label="/verify",
    dot_file="subgraphs/verify.dot",
    outputs="verify.verdict"
  ];

  // THE GATE for verify's return.
  // Same broken-substitution-token fix as CheckBuildVerdict above.
  CheckVerifyVerdict [
    shape=parallelogram, label="Check verify.verdict",
    tool_command="#!/bin/sh\nset -e\nprintf '%s' \"${verify.verdict}\""
  ];

  Finish [
    shape=folder, label="/finish",
    dot_file="subgraphs/finish.dot",
    outputs="finish.action,finish.merge_sha,finish.pr_url"
  ];

  Report [
    shape=box, fidelity="summary:high",
    label="Report Full Cycle",
    prompt="Summarize the complete cycle: design ($design_doc), plan ($plan_path), build (${build.tasks_completed} tasks, verdict ${build.verdict}), verify (${verify.verdict}), finish (PR opened: ${finish.pr_url} -- awaiting human review, no auto-merge occurred). "
  ];

  Start                -> ThinkLikeKen;
  ThinkLikeKen          -> RenameDesignDocForPlan;
  RenameDesignDocForPlan -> PlanLikeKen;
  PlanLikeKen           -> RenamePlanDocForBuild;
  RenamePlanDocForBuild -> BuildLikeKen;
  BuildLikeKen          -> CheckBuildVerdict;

  CheckBuildVerdict     -> Verify [condition="context.build.verdict=all_tasks_complete", weight="2"];
  CheckBuildVerdict     -> RenameBugDescriptionForBuildBlocked [condition="context.build.verdict=blocked"];
  RenameBugDescriptionForBuildBlocked -> Debug;

  // Routed back through the same rename bridges as the forward path (not
  // directly to BuildLikeKen/PlanLikeKen) -- ${plan.plan_doc}/
  // ${design.design_doc} are still the only names these dotted values exist
  // under in context; a direct loop-back edge would skip the bridge and
  // leave $plan_path/$design_doc stale or empty on the resumed run.
  Debug                 -> CheckResumeRoute;
  CheckResumeRoute      -> RenamePlanDocForBuild [condition="context.tool.last_line=continue_build", loop_restart="true", weight="2"];
  CheckResumeRoute      -> RenameDesignDocForPlan [condition="context.tool.last_line=replan", loop_restart="true"];
  CheckResumeRoute      -> ThinkLikeKen    [condition="context.tool.last_line=redesign", loop_restart="true"];

  Verify                -> CheckVerifyVerdict;
  CheckVerifyVerdict    -> Finish          [condition="context.verify.verdict=verified", weight="2"];
  CheckVerifyVerdict    -> RenameBugDescriptionForVerifyGap [condition="context.verify.verdict=not_verified"];
  RenameBugDescriptionForVerifyGap -> Debug;

  Finish                -> Report;
  Report                 -> Exit;
}
