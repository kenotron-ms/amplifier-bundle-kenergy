// plan_like_ken.dot
//
// Top-level attractor pipeline for /plan-like-ken: turn an approved design
// directly into an executable plan. No plan-approval gate, no task-by-task
// negotiation -- design approval (from think_like_ken.dot) was the planning
// authorization.
//
// Source of truth: modes/plan-like-ken.md ("Design approval is the planning
// authorization. Do not negotiate task breakdown... There is no
// plan-approval gate and no task-by-task negotiation."), agents/plan-writer.md
// (Global Constraints, Interfaces, per-task Description/Goal/Specification/
// Acceptance Criteria/Model Roles contract).
//
// DESIGN ORDER (docs/primer.md §3):
//   1. THE SINK: docs/plans/<date>-<feature>-implementation.md exists AND
//      demonstrably contains every section the executor
//      (subagent-driven-development.yaml) requires and validates as
//      non-empty per task -- not merely "the plan-writer said it wrote one."
//   2. THE GATE: ConfirmPlanArtifact is a deterministic parallelogram that
//      greps the actual file for the required section headers per task
//      (Description/Goal/Specification/Acceptance Criteria/Interfaces/Model
//      Roles) plus the plan-wide Global Constraints block -- never trusts
//      the plan-writer's own "plan_done" claim as proof the sections exist.
//   3. THE LOOP: this pipeline has exactly one cycle by design (RUBRIC.md
//      §1: "no cycle + LLM judgment = should probably have been a recipe").
//      Plan-writer is unambiguously an LLM judgment node (it decides task
//      breakdown, model roles, verification methods) -- so a missing/
//      malformed section routes back to FixPlanArtifact with the exact gap
//      named, not a bare failure.
//   4. THE WORK NODES were written last: DelegatePlanWriter,
//      ConfirmPlanArtifact, FixPlanArtifact, HandoffToExecution.
//
// No skill in this bundle's skill set maps to a subgraph here -- plan-like-ken
// is a single, direct, unnegotiated delegation to one agent. Forcing a
// persona-lens or verification-discipline subgraph into this graph would be
// exactly the kind of unnecessary structure cranky-old-sam's own skill
// argues against; this pipeline stays minimal because the task is minimal.
//
// Context inputs:
//   $design_doc - path to the approved design document (from think_like_ken.dot)
//
// Context outputs:
//   plan.plan_doc - path to the saved, validated implementation plan

digraph plan_like_ken {
  graph [
    label="Plan Like Ken -- direct plan generation, no approval gate",
    goal="$design_doc",
    rankdir=LR,
    default_max_retry=2,
    default_fidelity="summary:high",
    model_stylesheet="* { llm_model: claude-sonnet-4-6; llm_provider: anthropic; }"
  ];

  Start [shape=Mdiamond, label="Start"];
  Exit  [shape=Msquare,  label="Exit"];

  // Faithful to agents/plan-writer.md's contract: Global Constraints,
  // Interfaces, and the full per-task field set, resolved by engineering
  // judgment -- not negotiated with the human.
  DelegatePlanWriter [
    shape=box, goal_gate=true, fidelity="full",
    label="Delegate to Plan-Writer",
    prompt="Read the approved design at ${design_doc} and repository conventions. Resolve implementation-level details with engineering judgment -- do not ask the human to confirm task breakdown, granularity, ordering, or file decomposition unless the design leaves a fact only they can supply.\n\nWrite docs/plans/<date>-<feature>-implementation.md with: a header (Goal/Architecture/Tech Stack/Verification approach), a '## Global Constraints' block capturing the design's project-wide requirements verbatim, and one '### Task N' section per task, each with non-empty Description/Goal/Specification/Acceptance Criteria/Files/Interfaces (Consumes/Produces)/Model Roles (implementation_model_role, review_model_role, escalated_model_role) and complete, copy-pasteable code -- no '// add your code here' placeholders. Write .resolve/plan/plan_path.txt with the saved path. Call the report_outcome tool with status=\"success\" and preferred_label=\"plan_done\" (also print the single line: plan_done)"
  ];

  // THE GATE -- never trust "plan_done" as proof the required sections exist.
  ConfirmPlanArtifact [
    shape=parallelogram, label="Confirm Plan Artifact",
    tool_command="#!/bin/sh\nset -e\npython3 scripts/confirm_plan_contract.py --plan-path-file .resolve/plan/plan_path.txt"
  ];

  FixPlanArtifact [
    shape=box, goal_gate=true, fidelity="full",
    label="Fix Plan Sections",
    prompt="ConfirmPlanArtifact found this plan does not yet satisfy the required contract: ${tool.last_output}\n\nRe-delegate to kenergy:plan-writer's own contract and fix exactly the named gaps -- do not rewrite unrelated sections. Call the report_outcome tool with status=\"success\" and preferred_label=\"plan_fixed\" (also print the single line: plan_fixed)"
  ];

  HandoffToExecution [
    shape=box, goal_gate=true, fidelity="summary:high",
    label="Hand Off to Execution",
    prompt="Plan confirmed at $(cat .resolve/plan/plan_path.txt). Hand off directly to /build-like-ken (or subagent-driven-development.yaml) -- no approval prompt, no 'does this look right?' checkpoint. Call the report_outcome tool with status=\"success\" and preferred_label=\"handed_off\" (also print the single line: handed_off)"
  ];

  Start                -> DelegatePlanWriter;
  DelegatePlanWriter    -> ConfirmPlanArtifact;
  ConfirmPlanArtifact   -> HandoffToExecution [condition="context.tool.last_line=contract_satisfied", weight="2"];
  ConfirmPlanArtifact   -> FixPlanArtifact    [condition="context.tool.last_line=contract_violated"];
  FixPlanArtifact       -> ConfirmPlanArtifact [loop_restart="true"];
  HandoffToExecution    -> Exit;
}
