// finish.dot
//
// Top-level attractor pipeline for /finish: zero human checkpoints
// (2026-08-11 revision). A prior version paused on FinishDecision (merge/
// pr/keep/discard) and, for discard, a second typed-confirmation hexagon.
// Both are removed. The pipeline now auto-defaults to the one action that
// is both reversible and actually lands the work for review: open a PR.
// Never auto-merge (alters the base branch without review) and never
// auto-discard (irreversible, destroys work) -- those remain human-only
// actions outside this pipeline's autonomous path. The human checkpoint
// this mode used to provide is not gone, it has moved: PR review on GitHub
// IS where a human now looks at the work, exactly the point at which
// "earning the right to bother the user" naturally happens again.
//
// Source of truth: modes/finish.md, recipes/finish-branch.yaml (the
// capture-entry-paths worktree/branch containment guard from this bundle's
// own Task 14 fix, and determine-action's exact-match-only contract from
// Task 5's fix -- both rendered here as graph nodes rather than recipe
// steps).
//
// DESIGN ORDER (docs/primer.md §3):
//   1. THE SINK: the chosen action (merge / PR / keep / discard) has
//      actually happened against the real repository -- confirmed by an
//      independent check of real state (git log for a merge commit, `gh pr
//      view` for a PR), never by trusting the action node's own "I merged
//      it" / "I opened the PR" claim. This is exactly the failure class
//      docs/RUBRIC.md §2 documents in the attractor-pipelines repo's own
//      history: an OpenPR-style node can print a plausible URL or claim a
//      merge landed when it didn't.
//   2. THE GATE: ConfirmMergeLanded and ConfirmPROpened are deterministic
//      parallelogram checks against real Git/GitHub state -- built from
//      `git`/`gh` only, matching this repo's own portability note (never a
//      platform-specific helper, since these pipelines run wherever a
//      dot-graph-compatible engine fetches them).
//   3. THE LOOP: per docs/RUBRIC.md §1, an acyclic pipeline is acceptable
//      ONLY when it's a deterministic dispatcher with no LLM judgment to
//      converge (the rubric's own cited example: ship_ready.dot's
//      runtime-mode deploy branches). Once the human has made the finish
//      decision, dispatching to the matching action is exactly that kind of
//      deterministic branch -- so this graph is intentionally acyclic
//      downstream of the human hexagon. The one place real judgment
//      remains (did the merge/PR actually land?) is where the evidence
//      gates sit, not inside a loop.
//   4. THE WORK NODES were written last: CaptureEntryPaths, FinishDecision,
//      the four action branches, and their confirmation gates.
//
// No skill subgraph is invoked here. Finish is a deterministic dispatch on
// an explicit human choice, not a judgment task any of this bundle's eight
// skills addresses -- forcing one in would be exactly the unnecessary
// structure cranky-old-sam's own lens exists to catch.
//
// Context inputs: (none required -- operates on the current worktree)
//
// Context outputs:
//   finish.action        - "pr" (always -- merge/keep/discard removed, see header)
//   finish.pr_url          - set once the PR is independently confirmed opened

digraph finish {
  graph [
    label="Finish -- always opens a PR, zero human checkpoints",
    goal="a confirmed, open PR awaiting human review",
    rankdir=LR,
    default_max_retry=2,
    default_fidelity="summary:high",
    model_stylesheet="* { llm_model: claude-sonnet-4-6; llm_provider: anthropic; }"
  ];

  Start [shape=Mdiamond, label="Start"];
  // --- Bootstrap: fetch amplifier-bundle-kenergy's scripts/ so downstream
  // tool_command nodes can shell out to them by an addressable path. Needed
  // because scripts/*.py never travels with a remotely-fetched .dot file
  // (materialize_remote_dot only fetches dot_file= targets, never files
  // referenced only inside a tool_command string), and a tool node's CWD in
  // some execution environments (e.g. a Resolve worker) is the *target*
  // workspace repo, not this repo -- so a bare relative "scripts/..." or
  // "../../scripts/..." path is not reliably resolvable. Idempotent (skips
  // the clone if already present) so re-running this node, or reaching it
  // both standalone and nested under kenergy_full_cycle.dot, is harmless.
  Bootstrap [
    shape=parallelogram, label="Bootstrap Kenergy Scripts", parse_json="true",
    tool_command="#!/bin/sh\nset -e\nREF=\"${kenergy_ref:-main}\"\nD=\"/tmp/kenergy-$REF\"\nif [ ! -d \"$D/.git\" ]; then\n  git clone --depth 1 --branch \"$REF\" https://github.com/kenotron-ms/amplifier-bundle-kenergy \"$D\" >&2\nelse\n  git -C \"$D\" fetch --depth 1 origin \"$REF\" >&2 && git -C \"$D\" reset --hard FETCH_HEAD >&2\nfi\nprintf '{\"kenergy_root\":\"%s\"}' \"$D\""
  ];
  Exit  [shape=Msquare,  label="Exit"];

  // Faithful to recipes/finish-branch.yaml's capture-entry-paths (Task 14):
  // capture worktree/branch/main-repo paths ONCE, before anything mutates
  // directories, and validate the branch matches what's actually checked out
  // -- reject a caller-supplied branch_name that disagrees with reality.
  CaptureEntryPaths [
    shape=parallelogram, label="Capture Entry Paths",
    tool_command="#!/bin/sh\nset -e\npython3 ${kenergy_root}/scripts/capture_entry_paths.py --worktree \"${WORKTREE_PATH:-$(pwd)}\""
  ];

  ExecutePR [
    shape=box, fidelity="full",
    label="Execute Open PR",
    prompt="cd ${entry_paths.main_repo_path}. Push ${entry_paths.branch_name} and open a PR via gh pr create. Write $execution_root/.resolve/finish/pr_attempt.json with {\"attempted_url\":\"...\"}. "
  ];

  // Faithful to this repo's own deliver_pr.dot CheckPROpened case study
  // (docs/RUBRIC.md §2): never trust a printed URL as proof a PR exists.
  // Writes finish.action / finish.pr_url directly (parse_json="true") -- see
  // ConfirmMergeLanded's note above for the same fix on the merge path.
  ConfirmPROpened [
    shape=parallelogram, goal_gate=true, retry_target="ExecutePR", label="Confirm PR Opened", parse_json="true",
    tool_command="#!/bin/sh\nset -e\nurl=$(python3 -c \"import json;print(json.load(open('${execution_root}/.resolve/finish/pr_attempt.json'))['attempted_url'])\")\nif gh pr view \"$url\" >/dev/null 2>&1; then\n  printf '{\"route\":\"pr_confirmed\",\"finish.action\":\"pr\",\"finish.pr_url\":\"%s\"}' \"$url\"\nelse\n  printf '{\"route\":\"pr_unconfirmed\"}'\nfi"
  ];

  // Scope boundary (intentional): this graph stops at a PR-opened,
  // confirmed outcome. Auto-merge on top of the PR path, and any
  // merge/keep/discard automation, are deliberately out of scope -- those
  // require a human decision this pipeline no longer pauses to collect (see
  // header). A PR-review-fix loop on top of this is a separate future
  // "ship" attractor pipeline, not an addition to finish.dot.
  Report [
    shape=box, fidelity="summary:high",
    label="Report",
    prompt="Report the confirmed finish outcome plainly -- the PR URL. Do not claim the PR was opened unless independently confirmed above. State clearly that this PR now awaits human review before merge -- no auto-merge occurred or will occur from this pipeline. "
  ];

  Start                     -> Bootstrap;
  Bootstrap                 -> CaptureEntryPaths;
  CaptureEntryPaths          -> ExecutePR;

  ExecutePR                             -> ConfirmPROpened;
  ConfirmPROpened                        -> Report [condition="context.route=pr_confirmed", weight="2"];
  ConfirmPROpened                         -> ExecutePR [condition="context.route=pr_unconfirmed", label="retry once, bounded by default_max_retry=2"];

  Report                                        -> Exit;
}
