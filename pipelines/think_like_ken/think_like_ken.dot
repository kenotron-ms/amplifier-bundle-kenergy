// think_like_ken.dot
//
// Same contract as the original fine-grained version (one design doc at
// docs/plans/<date>-<topic>-design.md), rendered as a handful of large,
// English-prompt phases instead of ~26 fine-grained mechanical nodes.
//
// PHILOSOPHY: the graph shows LOOPS AND GATES, not every internal step of a
// phase. A phase node's prompt is the full instruction for that phase --
// gather context, find forks, decide, synthesize, review -- exactly as a
// human collaborator would be told to "go do phase 2," not walked through
// it click by click. This trades some routing visibility (see
// docs/designs/kenergy-pipeline-embedded-routing-logic.md, which argued the
// opposite direction for the PREVIOUS version of this graph -- that design
// was about eliminating HIDDEN forks buried in scripts, not about node
// count; a phase node doing its own internal reasoning in prose is not the
// same anti-pattern as a shell script silently branching on business
// meaning) for a shape that reads like the mode's own prose almost
// verbatim.
//
// Source of truth: modes/think-like-ken.md (prompts ported near-verbatim,
// same discipline build_like_ken.dot already uses for Implement/Reviewer).
//
// What stays as separate nodes, and why (the only genuine structural forks
// or delegation-substitutes):
//   - ConsolidatedApproval: the ONLY human hexagon in this graph. Genuine
//     forks (decisions only the human can make -- personal preference, or a
//     fact only they know) are no longer a separate mid-pipeline pause. The
//     model makes its best defensible assumption for each one, flags it
//     explicitly in the consolidated review, and the human answers/corrects
//     it in the SAME reply where they approve or revise -- ReviseDecisions
//     already handles arbitrary corrections, so fork answers ride the same
//     mechanism at zero extra cost. A prior version had a second hexagon
//     (ResolveForks, gated by ForkGate reading forks.json) that stopped the
//     pipeline mid-flight for forks specifically; collapsing that into the
//     one approval checkpoint halves the number of places a run can sit
//     waiting on a human reply, with no loss of "only a human can answer
//     this" discipline.
//   - WriteDesignDoc: acts directly in the design-writer role by reading
//     $execution_root/.resolve/kenergy/agents/design-writer.md (staged by
//     Bootstrap) rather than "delegating" to a named sub-agent --
//     session.spawn-based delegation is not reliably available inside a
//     Resolve worker container (confirmed via live investigation), and
//     there is no `delegate=`/`agent=` DOT attribute and no way to mount
//     Amplifier's own delegate() tool into a box node's session today (also
//     confirmed). Inlining the persona is the correct, portable substitute
//     for delegation -- not a shortcut.
//   - ReviewCycle / ReviewCycleGate: kept separate specifically because
//     their exit condition must be deterministic (see bump_cycle.py) --
//     collapsing them into one phase would hide the review LOOP itself,
//     which is exactly the kind of structure that should stay visible. The
//     cycle count is tracked by an external script, never self-reported by
//     the LLM into its own verdict file (a prior version of this bug let a
//     model write {"cycle": 1} on its 14th iteration, defeating the cap).
//
// Context inputs:
//   $execution_root    - worktree/repo root all phases execute inside
//   $kenergy_ref       - (optional) git ref of amplifier-bundle-kenergy to
//                        bootstrap scripts/ + agent personas from; defaults
//                        to "main".
//
// Context outputs:
//   design.design_doc  - absolute path to the saved design document

digraph think_like_ken {
  graph [
    label="Think Like Ken -- coarse phases, big English prompts",
    rankdir=LR,
    default_max_retry=3,
    default_fidelity="full",
    model_stylesheet="* { llm_model: claude-sonnet-4-6; llm_provider: anthropic; }"
  ];

  Start [shape=Mdiamond, label="Start"];
  Exit  [shape=Msquare,  label="Exit"];

  // --- Bootstrap: fetch amplifier-bundle-kenergy's scripts/ + stage agent
  // persona files under $execution_root so downstream nodes can `cat` them
  // by an addressable path (needed for the design-writer inline-persona
  // pattern below). Idempotent (skips the clone if already present). ---
  Bootstrap [
    shape=parallelogram, label="Bootstrap Kenergy Scripts + Agent Personas", parse_json="true",
    tool_command="#!/bin/sh\nset -e\nREF=\"${kenergy_ref:-main}\"\nD=\"/tmp/kenergy-$REF\"\nif [ ! -d \"$D/.git\" ]; then\n  git clone --depth 1 --branch \"$REF\" https://github.com/kenotron-ms/amplifier-bundle-kenergy \"$D\" >&2\nelse\n  git -C \"$D\" fetch --depth 1 origin \"$REF\" >&2 && git -C \"$D\" reset --hard FETCH_HEAD >&2\nfi\nmkdir -p \"$execution_root/.resolve/kenergy/agents\"\ncp \"$D/agents/design-writer.md\" \"$execution_root/.resolve/kenergy/agents/design-writer.md\"\nprintf '{\"kenergy_root\":\"%s\"}' \"$D\""
  ];

  // --- Phase 1-2 collapsed: gather context AND identify genuine forks in
  // one pass. Forks are recorded for transparency and for DecideAndReview
  // to flag explicitly, but they no longer cause a separate mid-pipeline
  // pause -- see header note on ConsolidatedApproval. ---
  UnderstandAndIdentifyForks [
    shape=box,
    label="Understand Context + Identify Forks (Phases 1-2)",
    prompt="Understand this codebase and the request well enough to design a solution. Read relevant code, git history, related prior designs, and any existing conventions. Then identify genuine forks -- decisions that only the human can make (personal preference, or a fact only they know) -- as distinct from decisions you can make yourself with evidence and precedent. Do not invent forks to be safe; only genuine ambiguity belongs here. Write $execution_root/.resolve/design/context.json with your understanding (evidence gathered, constraints found) and a \"forks\" array of {\"topic\":\"...\",\"question\":\"...\"} -- empty if none genuinely exist."
  ];

  ContextArtifactGate [
    shape=parallelogram, goal_gate=true, retry_target="UnderstandAndIdentifyForks", label="Context Artifact Written?",
    tool_command="#!/bin/sh\nset -e\np=\"${execution_root}/.resolve/design/context.json\"\nif [ -s \"$p\" ]; then printf 'ok'; else printf 'missing'; fi"
  ];

  // --- Phase 3-4 collapsed: decide everything with a defensible answer
  // (evidence, precedent, YAGNI), apply BOTH persona lenses inline as part
  // of the same thinking pass (no separate NeedsSimplicityLens/
  // NeedsConsequenceLens gates -- the prompt instructs the model to embody
  // both perspectives itself, same "inline persona lens, do not dispatch as
  // a separate agent" discipline the mode already requires elsewhere), and
  // present ONE consolidated review. For any genuine fork found in Phase
  // 1-2, make the best defensible assumption and flag it explicitly as an
  // open question in the review -- the human resolves it (or corrects it)
  // in the same reply as ConsolidatedApproval, not a separate pause. ---
  DecideAndReview [
    shape=box,
    label="Decide + Apply Lenses + Consolidated Review (Phases 3-4)",
    prompt="Using the context from $execution_root/.resolve/design/context.json, decide every remaining engineering decision with a defensible answer -- evidence, precedent, this project's own constraints. Apply YAGNI ruthlessly, no speculative features. For any genuine fork recorded in context.json, make your own best defensible assumption for now but flag it explicitly and clearly as an open question the human should confirm or correct. Then review your own recommendation from two angles before presenting it: (1) as a simplicity-obsessed reviewer who interrogates every abstraction and unnecessary layer, (2) as a systems engineer who has watched too many designs collapse under hidden consequences and unintended costs. Incorporate anything real either lens surfaces. Then present ONE consolidated review: goal, recommended approach, key components, important trade-offs, evidence-backed decisions, lens critique incorporated, and any flagged forks awaiting human confirmation. This is the ONLY approval gate in this mode -- do not fragment it into sections. Write $execution_root/.resolve/design/decisions.json with {\"decisions\":[{\"question\":\"...\",\"choice\":\"...\",\"reasoning\":\"...\"}]}."
  ];

  ConsolidatedApproval [
    shape=hexagon, mode="freeform",
    label="Explicit Design Approval",
    prompt="Above is the consolidated design review. Type approve/yes/ok to proceed to writing the design document, or reply with corrections to revise the recommendation first."
  ];

  // fidelity="full" overrides the graph default here: this gate greps
  // $last_response for approval keywords, which truncates to 200 chars
  // except under fidelity=full.
  CheckConsolidatedApproval [
    shape=parallelogram, label="Check Consolidated Approval",
    tool_command="bash -c 'if echo \"$last_response\" | grep -iEq \"approve|\\byes\\b|\\bok\\b\"; then echo approved; else echo revise; fi'"
  ];

  ReviseDecisions [
    shape=box,
    label="Incorporate Corrections",
    prompt="Incorporate the human's corrections ($last_response) into $execution_root/.resolve/design/decisions.json, then re-present the consolidated review reflecting the changes."
  ];

  // --- Phase 5: write the doc. Acts directly in the design-writer role by
  // reading its persona file -- delegation substitute, see header note. ---
  WriteDesignDoc [
    shape=box,
    label="Write Design Document (Phase 5)",
    prompt="Follow the role defined in $(cat $execution_root/.resolve/kenergy/agents/design-writer.md) exactly. Write the design document yourself now -- do not attempt to delegate or spawn a separate agent. Include the complete approved consolidated review and all resolved fork answers. Save to $execution_root/docs/plans/<date>-<topic>-design.md with: goal, chosen approach, architecture, components, data flow, error handling, testing strategy, open questions. Write $execution_root/.resolve/design/design_doc_path.txt with the saved path."
  ];

  // Deterministic gate: WriteDesignDoc's own claim is not proof the file
  // actually exists -- confirm the path it was supposed to write is real
  // and non-empty before the review cycle reads it.
  DesignDocArtifactGate [
    shape=parallelogram, goal_gate=true, retry_target="WriteDesignDoc", label="Design Doc Actually Saved?",
    tool_command="#!/bin/sh\nset -e\npath=$(cat ${execution_root}/.resolve/design/design_doc_path.txt 2>/dev/null || true)\nif [ -n \"$path\" ] && [ -s \"$path\" ]; then printf 'ok'; else printf 'missing'; fi"
  ];

  // --- Phase 6: review loop -- kept as its own visible LOOP (this is
  // exactly the kind of structure the graph SHOULD show). Self-review +
  // adversarial review folded into one prompt per cycle; fixes made
  // in-role directly (delegation substitute, same as WriteDesignDoc).
  // Deterministic cap via bump_cycle.py -- see header note. ---
  ReviewCycle [
    shape=box,
    label="Self + Adversarial Review (one cycle)",
    prompt="Read the design document at $(cat $execution_root/.resolve/design/design_doc_path.txt). First, self-review: no placeholders/TODOs, internal consistency, every item traces to a real requirement, no vague language. Then dispatch an adversarial review of the same document using the prompt at kenergy:context/spec-document-review-prompt.md. If either review finds issues, fix them directly in the document now -- follow the role defined in $(cat $execution_root/.resolve/kenergy/agents/design-writer.md) exactly, do not attempt to delegate or spawn a separate agent. Write $execution_root/.resolve/design/review_result.json with {\"pass\":true|false,\"issues\":[...]}."
  ];

  // Cycle count is tracked DETERMINISTICALLY by scripts/bump_cycle.py, not
  // self-reported by the LLM into its own verdict file. Increments exactly
  // once per ReviewCycleGate execution (which runs exactly once per full
  // loop iteration). The model's pass/fail verdict is still read from its
  // own JSON -- that is a legitimate judgment call, not a loop-bound
  // counter -- only the count that gates the bound is external.
  ReviewCycleGate [
    shape=parallelogram, goal_gate=true, retry_target="ReviewCycle", label="Review Pass or Cap Reached?",
    tool_command="#!/bin/sh\nset -e\ncycle=$(python3 ${kenergy_root}/scripts/bump_cycle.py --state-file \"${execution_root}/.resolve/design/review_cycle.count\" | python3 -c \"import json,sys;print(json.load(sys.stdin)['cycle'])\")\npython3 -c \"\nimport json\nd=json.load(open('${execution_root}/.resolve/design/review_result.json'))\ncycle=$cycle\nif d['pass']: print('pass')\nelif cycle >= 3: print('cap_reached')\nelse: print('revise')\n\""
  ];

  // Report-only: this pipeline's sink is exactly one artifact (a design
  // document). Deterministic (no LLM) -- must not hint at, suggest, or
  // imply any next step, including naming /plan-like-ken or "implementation
  // planning." If a user wants the full think->plan->build->verify->finish
  // flow, that is what kenergy_full_cycle is for; this standalone pipeline
  // should not try to route them toward it.
  Report [
    shape=parallelogram, label="Report Final Artifact",
    tool_command="#!/bin/sh\nset -e\npath=$(cat $execution_root/.resolve/design/design_doc_path.txt)\nprintf 'Design document saved to %s. Design phase complete.\\n' \"$path\""
  ];

  // --- Bridge: emits the flat design_doc context key from the file, since
  // no node above writes it as flat context directly -- only to a file. A
  // folder node's outputs= merge only promotes keys that actually exist in
  // the child's final context. ---
  EmitDesignDocOutput [
    shape=parallelogram, label="Emit design.design_doc Output",
    tool_command="#!/bin/sh\nset -e\npath=$(cat ${execution_root}/.resolve/design/design_doc_path.txt)\npython3 -c \"import json;print(json.dumps({'design.design_doc': '$path'}))\""
  ];

  Start                        -> Bootstrap;
  Bootstrap                    -> UnderstandAndIdentifyForks;
  UnderstandAndIdentifyForks   -> ContextArtifactGate;
  ContextArtifactGate          -> DecideAndReview  [condition="context.tool.last_line=ok", weight="2"];
  ContextArtifactGate          -> UnderstandAndIdentifyForks [condition="context.tool.last_line=missing", loop_restart="true", label="retry -- artifact missing/malformed, bounded by default_max_retry=3"];

  DecideAndReview                -> ConsolidatedApproval;
  ConsolidatedApproval           -> CheckConsolidatedApproval [fidelity="full"];
  CheckConsolidatedApproval      -> WriteDesignDoc  [condition="context.tool.last_line=approved", weight="2"];
  CheckConsolidatedApproval      -> ReviseDecisions [condition="context.tool.last_line=revise"];
  ReviseDecisions                -> ConsolidatedApproval [loop_restart="true"];

  WriteDesignDoc                 -> DesignDocArtifactGate;
  DesignDocArtifactGate          -> ReviewCycle       [condition="context.tool.last_line=ok", weight="2"];
  DesignDocArtifactGate          -> WriteDesignDoc    [condition="context.tool.last_line=missing", loop_restart="true", label="retry -- doc not actually saved, bounded by default_max_retry=3"];
  ReviewCycle                    -> ReviewCycleGate;
  ReviewCycleGate                -> Report      [condition="context.tool.last_line=pass", weight="2"];
  ReviewCycleGate                -> Report      [condition="context.tool.last_line=cap_reached", label="3-cycle cap reached -- proceed with residual findings noted"];
  ReviewCycleGate                -> ReviewCycle [condition="context.tool.last_line=revise"];

  Report -> EmitDesignDocOutput;
  EmitDesignDocOutput -> Exit;
}
