// think_like_ken.dot
//
// Top-level attractor pipeline for /think-like-ken: evidence-led design
// refinement that interrupts the human only at genuine forks, then produces
// one consolidated design review, one approval, and a written, self-reviewed
// design document.
//
// Source of truth: modes/think-like-ken.md (the mode contract, verbatim
// phase names and prompts below), skills/cranky-old-sam/SKILL.md,
// skills/crusty-old-engineer/SKILL.md (persona lenses, rendered as
// subgraphs), agents/design-writer.md.
//
// DESIGN ORDER (docs/primer.md §3):
//   1. THE SINK: a design document exists at docs/plans/<date>-<topic>-design.md,
//      has passed a 4-point self-review (no placeholders, internally
//      consistent, no scope creep, no ambiguity) AND an adversarial spec
//      review (capped at 3 cycles), AND the human's own approval text was
//      captured for the consolidated review that preceded it -- not assumed
//      from silence or inferred from continuing the conversation.
//   2. THE GATE: CheckSelfReview reads a JSON self-review result (not LLM
//      prose); CheckConsolidatedApproval greps the human hexagon's own reply
//      with fidelity="full" (per docs/RUBRIC.md §3.4 -- this is exactly the
//      "human's freeform approval reply" case that carve-out exists for).
//   3. THE LOOP: ResolveGenuineForks loops on itself until no user-only fork
//      remains (mode's Phase 2, "end this phase as soon as no user-only fork
//      remains" -- an unbounded-by-design loop since it's gated on a real
//      state, not a fixed count). SelfReview/AdversarialReview loop back to
//      revision, capped at 3 cycles per the mode's own "Run up to 3 review
//      cycles maximum before proceeding."
//   4. THE WORK NODES were written last: UnderstandContext, ResolveForks,
//      SynthesizeDecisions (with optional inline persona-lens subgraphs),
//      ConsolidatedReview, DelegateDesignWriter, SelfReview, AdversarialReview.
//
// Foot-guns audited: no shape=diamond; ApprovalGate/SelfReviewGate/
// AdversarialGate all route on files or fidelity="full" human replies, never
// truncated $last_response prose; ResolveGenuineForks' loop is gated on an
// observed "no_forks_remaining" file field, not on the box node simply
// finishing talking.
//
// Context inputs:
//   $topic - the idea/feature being designed
//
// Context outputs:
//   design.design_doc - path to the written, self-reviewed design document

digraph think_like_ken {
  graph [
    label="Think Like Ken -- evidence-led design refinement, genuine forks only",
    goal="$topic",
    rankdir=LR,
    default_max_retry=3,
    default_fidelity="summary:high",
    model_stylesheet="* { llm_model: claude-sonnet-4-6; llm_provider: anthropic; }"
  ];

  Start [shape=Mdiamond, label="Start"];
  Exit  [shape=Msquare,  label="Exit"];

  // Phase 1: Understand Context
  UnderstandContext [
    shape=box, fidelity="summary:high",
    label="Understand Context (Phase 1)",
    prompt="Topic: $topic\n\nBefore asking any question: check the current project state (files, docs, recent commits), read referenced documents or existing designs, gather relevant evidence, precedent, and research. State what you understand about the project context. Write $execution_root/.resolve/design/context.json with {\"summary\":\"...\",\"open_questions\":[...]} -- open_questions are candidate genuine user-only forks, not yet confirmed"
  ];

  // Deterministic gate (added per the goal_gate self-report audit): never
  // trust "context_understood" report_outcome/text alone as proof
  // UnderstandContext actually did the work -- confirmed live (the
  // todoapp-attractor-pipeline run) that a model can call report_outcome
  // zero times across 4/4 attempts while still producing plausible prose.
  // This reads the FILE the prompt requires and checks it has the two
  // required keys with real values, never the box node's own claim.
  ContextArtifactGate [
    shape=parallelogram, goal_gate=true, retry_target="UnderstandContext", label="Context Artifact Written?",
    tool_command="#!/bin/sh\nset -e\npython3 -c \"\nimport json,sys\ntry:\n  d=json.load(open('${execution_root}/.resolve/design/context.json'))\n  ok = isinstance(d.get('summary'), str) and d['summary'].strip() != '' and isinstance(d.get('open_questions'), list)\nexcept Exception:\n  ok = False\nprint('ok' if ok else 'missing')\n\""
  ];

  // Phase 2: Resolve Genuine User-Only Forks -- a real loop, gated on
  // observed state ("no_forks_remaining"), not a fixed iteration count.
  // Faithful to the mode's Phase 2: "Ask directly when the answer is a
  // personal preference or a fact only the user knows. Batch related
  // questions by topic... End this phase as soon as no user-only fork
  // remains."
  IdentifyForks [
    shape=box, fidelity="summary:high",
    label="Identify Remaining Genuine Forks",
    prompt="Given the context in $execution_root/.resolve/design/context.json and any prior answers in $execution_root/.resolve/design/fork_answers.json (if it exists), list only the OPEN decisions that are genuine personal-preference questions or facts only the user knows -- not engineering questions with a defensible answer. Batch them by topic; never split one topic into micro-decisions. Write $execution_root/.resolve/design/forks.json with {\"has_forks\":true|false,\"forks\":[{\"topic\":\"...\",\"question\":\"...\"}]}"
  ];

  ForkGate [
    shape=parallelogram, goal_gate=true, retry_target="IdentifyForks", label="Any Forks Remaining?",
    tool_command="#!/bin/sh\nset -e\npython3 -c \"import json;print('has_forks' if json.load(open('${execution_root}/.resolve/design/forks.json'))['has_forks'] else 'no_forks')\""
  ];

  ResolveForks [
    shape=hexagon, mode="freeform",
    label="Resolve Genuine Forks",
    prompt="These decisions genuinely need you -- either a personal preference or a fact only you know. They're batched by topic below; answer as many as you'd like in one reply.\n\n${tool.last_output}"
  ];

  RecordForkAnswers [
    shape=parallelogram, label="Record Fork Answers",
    tool_command="#!/bin/sh\nset -e\npython3 ../../scripts/append_fork_answers.py --reply \"${last_response}\"\nprintf 'recorded'"
  ];

  // Phase 3: Synthesize Evidence-Backed Decisions, with an optional inline
  // persona-lens sanity check -- these are subgraphs, not separate agent
  // dispatches, matching the mode's explicit "embody an inline persona lens;
  // do not dispatch it as a separate agent."
  SynthesizeDecisions [
    shape=box, fidelity="full",
    label="Synthesize Evidence-Backed Decisions (Phase 3)",
    prompt="For every remaining engineering decision with a defensible answer, decide directly using evidence, precedent, research, and the project's constraints. Apply YAGNI ruthlessly -- no speculative features. Record each choice and brief reasoning. Write $execution_root/.resolve/design/decisions.json with {\"decisions\":[{\"question\":\"...\",\"choice\":\"...\",\"reasoning\":\"...\"}], \"needs_simplicity_lens\":true|false, \"needs_consequence_lens\":true|false}"
  ];

  DecisionRoute [
    shape=parallelogram, goal_gate=true, retry_target="SynthesizeDecisions", label="Which Lens, If Any?",
    tool_command="#!/bin/sh\nset -e\npython3 -c \"import json;d=json.load(open('${execution_root}/.resolve/design/decisions.json'));print('both' if d['needs_simplicity_lens'] and d['needs_consequence_lens'] else 'simplicity' if d['needs_simplicity_lens'] else 'consequence' if d['needs_consequence_lens'] else 'none')\""
  ];

  // `inputs="decisions_path"` was inert (PipelineHandler.execute() never
  // reads `inputs=`) AND decisions_path itself was never actually set by any
  // upstream node in this graph -- cosam_lens.dot/coe_lens.dot's own
  // ${decisions_path} prompt token would have expanded to nothing.
  // SynthesizeDecisions always writes to the fixed path
  // .resolve/design/decisions.json, so seed it as a literal (folder
  // context.<key> attrs are never substituted -- see build_like_ken.dot's
  // DefineTaskCriteria note -- a literal path is exactly what belongs here).
  SimplicityLens [
    shape=folder, label="Cranky Old Sam Lens (simplicity)",
    dot_file="subgraphs/cosam_lens.dot",
    context.decisions_path=".resolve/design/decisions.json",
    outputs="cosam.findings"
  ];

  ConsequenceLens [
    shape=folder, label="Crusty Old Engineer Lens (consequences)",
    dot_file="subgraphs/coe_lens.dot",
    context.decisions_path=".resolve/design/decisions.json",
    outputs="coe.findings"
  ];

  // Phase 4: Consolidated Final Design Review -- the mode's single
  // pre-delegation approval gate. "Do not ask for section-level approval or
  // create another approval checkpoint after it."
  ConsolidatedReview [
    shape=box, fidelity="full",
    label="Consolidated Review (Phase 4)",
    prompt="Present ONE consolidated review covering: the goal, recommended approach, key components, important trade-offs, evidence-backed decisions (from $execution_root/.resolve/design/decisions.json), any lens critique incorporated (${cosam.findings} ${coe.findings}), and any remaining genuine forks. This is the ONLY approval gate in this mode -- do not fragment it into sections. "
  ];

  ConsolidatedApproval [
    shape=hexagon, mode="freeform",
    label="Explicit Design Approval",
    prompt="Above is the consolidated design review. Type approve/yes/ok to proceed to writing the design document, or reply with corrections to revise the recommendation first."
  ];

  // fidelity="full" here overrides the graph default: this gate greps
  // $last_response for approval keywords, and per docs/primer.md's foot-gun
  // card #3, last_response truncates to 200 chars except under fidelity=full.
  CheckConsolidatedApproval [
    shape=parallelogram, label="Check Consolidated Approval",
    tool_command="bash -c 'if echo \"$last_response\" | grep -iEq \"approve|\\byes\\b|\\bok\\b\"; then echo approved; else echo revise; fi'"
  ];

  ReviseSynthesis [
    shape=box, fidelity="full",
    label="Incorporate Corrections",
    prompt="Incorporate the human's corrections ($last_response) into $execution_root/.resolve/design/decisions.json. "
  ];

  // Phase 5: Delegate Design Document Creation -- mandatory delegation, the
  // mode itself cannot write files (write_file/edit_file blocked structurally).
  DelegateDesignWriter [
    shape=box, fidelity="full",
    label="Delegate to Design-Writer",
    prompt="Delegate document creation to kenergy:design-writer. Include the complete approved consolidated review and all resolved fork answers. Instruct it to save to $execution_root/docs/plans/<date>-<topic>-design.md with: goal, chosen approach, architecture, components, data flow, error handling, testing strategy, open questions. Write $execution_root/.resolve/design/design_doc_path.txt with the saved path. "
  ];

  // Deterministic gate: DelegateDesignWriter's own report_outcome claim is
  // not proof the design-writer subagent actually saved a file -- confirm
  // the path it was supposed to write actually exists and the file it
  // points at is non-empty before SelfReview reads it.
  DesignDocArtifactGate [
    shape=parallelogram, goal_gate=true, retry_target="DelegateDesignWriter", label="Design Doc Actually Saved?",
    tool_command="#!/bin/sh\nset -e\npath=$(cat ${execution_root}/.resolve/design/design_doc_path.txt 2>/dev/null || true)\nif [ -n \"$path\" ] && [ -s \"$path\" ]; then printf 'ok'; else printf 'missing'; fi"
  ];

  // Phase 6: Spec Self-Review -- 4-point checklist, then adversarial review,
  // capped at 3 cycles.
  SelfReview [
    shape=box, fidelity="full",
    label="Spec Self-Review (4-point checklist)",
    prompt="Read the design document at $(cat $execution_root/.resolve/design/design_doc_path.txt). Check: (1) Placeholder scan -- no [TBD]/[TODO]/[FILL IN]/empty sections; (2) Internal consistency -- component names, data flows, interfaces align throughout; (3) Scope check -- every item traces to a user requirement, nothing extra snuck in; (4) Ambiguity check -- no vague terms like 'handle errors appropriately' without specifics. Write $execution_root/.resolve/design/self_review.json with {\"pass\":true|false,\"issues\":[...]}"
  ];

  SelfReviewGate [
    shape=parallelogram, goal_gate=true, retry_target="SelfReview", label="Self-Review Pass?",
    tool_command="#!/bin/sh\nset -e\npython3 -c \"import json;print('pass' if json.load(open('${execution_root}/.resolve/design/self_review.json'))['pass'] else 'fail')\""
  ];

  FixSelfReview [
    shape=box, fidelity="full",
    label="Re-delegate Corrections",
    prompt="Re-delegate to kenergy:design-writer with the specific issues from $execution_root/.resolve/design/self_review.json. "
  ];

  AdversarialReview [
    shape=box, fidelity="full",
    label="Antagonistic Spec Review",
    prompt="Dispatch an adversarial review of $(cat $execution_root/.resolve/design/design_doc_path.txt) using the prompt at kenergy:context/spec-document-review-prompt.md. Write $execution_root/.resolve/design/adversarial_review.json with {\"pass\":true|false,\"findings\":[...],\"cycle\":<int>}. "
  ];

  AdversarialGate [
    shape=parallelogram, goal_gate=true, retry_target="AdversarialReview", label="Adversarial Review Pass or Cap Reached?",
    tool_command="#!/bin/sh\nset -e\npython3 -c \"\nimport json\nd=json.load(open('${execution_root}/.resolve/design/adversarial_review.json'))\nif d['pass']: print('pass')\nelif d['cycle'] >= 3: print('cap_reached')\nelse: print('revise')\n\""
  ];

  Report [
    shape=box, fidelity="summary:high",
    label="Report Final Artifact",
    prompt="Design document saved to $(cat $execution_root/.resolve/design/design_doc_path.txt). The approved design is complete and ready for implementation planning. "
  ];

  Start                       -> UnderstandContext;
  UnderstandContext           -> ContextArtifactGate;
  ContextArtifactGate         -> IdentifyForks       [condition="context.tool.last_line=ok", weight="2"];
  ContextArtifactGate         -> UnderstandContext    [condition="context.tool.last_line=missing", loop_restart="true", label="retry -- artifact not written or malformed, bounded by default_max_retry=3"];
  IdentifyForks               -> ForkGate;
  ForkGate                    -> ResolveForks         [condition="context.tool.last_line=has_forks"];
  ForkGate                    -> SynthesizeDecisions  [condition="context.tool.last_line=no_forks", weight="2"];
  ResolveForks                -> RecordForkAnswers     [fidelity="full"];
  RecordForkAnswers           -> IdentifyForks         [loop_restart="true", label="re-check for new forks"];

  SynthesizeDecisions         -> DecisionRoute;
  DecisionRoute                -> SimplicityLens   [condition="context.tool.last_line=simplicity"];
  DecisionRoute                -> ConsequenceLens   [condition="context.tool.last_line=consequence"];
  DecisionRoute                -> ConsolidatedReview [condition="context.tool.last_line=none", weight="2"];
  SimplicityLens               -> ConsolidatedReview;
  ConsequenceLens               -> ConsolidatedReview;

  ConsolidatedReview            -> ConsolidatedApproval;
  ConsolidatedApproval          -> CheckConsolidatedApproval [fidelity="full"];
  CheckConsolidatedApproval     -> DelegateDesignWriter [condition="context.tool.last_line=approved", weight="2"];
  CheckConsolidatedApproval     -> ReviseSynthesis      [condition="context.tool.last_line=revise"];
  ReviseSynthesis               -> ConsolidatedReview   [loop_restart="true"];
  DelegateDesignWriter            -> DesignDocArtifactGate;
  DesignDocArtifactGate           -> SelfReview             [condition="context.tool.last_line=ok", weight="2"];
  DesignDocArtifactGate           -> DelegateDesignWriter    [condition="context.tool.last_line=missing", loop_restart="true", label="retry -- doc not actually saved, bounded by default_max_retry=3"];
  SelfReview                     -> SelfReviewGate;
  SelfReviewGate                 -> AdversarialReview   [condition="context.tool.last_line=pass", weight="2"];
  SelfReviewGate                 -> FixSelfReview        [condition="context.tool.last_line=fail"];
  FixSelfReview                   -> SelfReview          [loop_restart="true"];
  AdversarialReview                -> AdversarialGate;
  AdversarialGate                  -> Report             [condition="context.tool.last_line=pass", weight="2"];
  AdversarialGate                  -> Report             [condition="context.tool.last_line=cap_reached", label="3-cycle cap reached -- proceed with residual findings noted"];
  AdversarialGate                  -> FixSelfReview        [condition="context.tool.last_line=revise"];

  Report                            -> Exit;
}
